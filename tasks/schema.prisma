// Prisma schema · 愈见 CareLoop
// 数据库：PostgreSQL 16 + pgvector
// 本文件与 docs/data-model.md 一一对应

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================ 枚举 ============================

enum Role {
  PATIENT
  CLINICIAN
  ADMIN
}

enum DocType {
  DISCHARGE_SUMMARY
  ORDER_SHEET
  LAB_REPORT
  OTHER
}

enum DocStatus {
  UPLOADED
  PARSING
  PARSED
  CONFIRMED
  FAILED
}

enum FollowUpType {
  MEDICATION
  REVISIT
  EXAM
  WOUND_CARE
  PRECAUTION
}

enum ItemStatus {
  PENDING
  DONE
  SKIPPED
  MISSED
}

enum ReminderStatus {
  PENDING
  SENT
  ACKED
  SNOOZED
  SKIPPED
  EXPIRED
}

enum AckAction {
  TAKEN
  SNOOZE
  SKIP
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

enum AlertSeverity {
  YELLOW
  RED
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum AlertSource {
  SYMPTOM
  CHECKIN
  REMINDER
  MANUAL
}

enum NotifyChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

// ============================ 用户与角色 ============================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?
  clinicianProfile ClinicianProfile?
  handledAlerts    Alert[]            @relation("AlertHandler")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

model PatientProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  gender            String?
  birthDate         DateTime?
  chronicConditions String[]  @default([])
  allergies         String[]  @default([])
  riskLevel         RiskLevel @default(GREEN)
  emergencyContact  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicianLinks   PatientClinician[] @relation("PatientSide")
  documents        Document[]
  medicationPlans  MedicationPlan[]
  followUpPlans    FollowUpPlan[]
  followUpItems    FollowUpItem[]
  reminders        Reminder[]
  checkIns         CheckIn[]
  symptomReports   SymptomReport[]
  alerts           Alert[]
  conversations    Conversation[]

  @@map("patient_profiles")
}

model ClinicianProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  department String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientLinks   PatientClinician[] @relation("ClinicianSide")

  @@map("clinician_profiles")
}

// 患者 - 医护 负责关系（多对多）
model PatientClinician {
  patientId   String
  clinicianId String
  primary     Boolean  @default(false)
  createdAt   DateTime @default(now())

  patient   PatientProfile   @relation("PatientSide", fields: [patientId], references: [id], onDelete: Cascade)
  clinician ClinicianProfile @relation("ClinicianSide", fields: [clinicianId], references: [id], onDelete: Cascade)

  @@id([patientId, clinicianId])
  @@index([clinicianId])
  @@map("patient_clinicians")
}

// ============================ 出院资料 ============================

model Document {
  id           String    @id @default(cuid())
  patientId    String
  type         DocType   @default(DISCHARGE_SUMMARY)
  fileUrl      String
  rawText      String?
  parsedJson   Json?
  status       DocStatus @default(UPLOADED)
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient         PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationPlans MedicationPlan[]
  followUpPlan    FollowUpPlan?

  @@index([patientId, createdAt])
  @@map("documents")
}

// ============================ 用药与随访 ============================

model MedicationPlan {
  id            String    @id @default(cuid())
  patientId     String
  documentId    String?
  drugName      String
  dosage        String
  frequency     String
  times         String[]  @default([])
  instructions  String?
  startDate     DateTime
  endDate       DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  document  Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([patientId, active])
  @@map("medication_plans")
}

model FollowUpPlan {
  id               String   @id @default(cuid())
  patientId        String
  title            String
  sourceDocumentId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  source   Document?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  items    FollowUpItem[]

  @@index([patientId])
  @@map("follow_up_plans")
}

model FollowUpItem {
  id          String       @id @default(cuid())
  planId      String
  patientId   String
  type        FollowUpType
  title       String
  description String?
  scheduledAt DateTime
  status      ItemStatus   @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  plan      FollowUpPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([patientId, scheduledAt])
  @@index([planId])
  @@map("follow_up_items")
}

// ============================ 提醒与升级 ============================

model Reminder {
  id               String         @id @default(cuid())
  patientId        String
  itemId           String?
  medicationPlanId String?
  title            String
  scheduledAt      DateTime
  sentAt           DateTime?
  nextActionAt     DateTime?
  status           ReminderStatus @default(PENDING)
  escalationLevel  Int            @default(0)
  channel          NotifyChannel  @default(IN_APP)
  ackAction        AckAction?
  ackedAt          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  item           FollowUpItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  medicationPlan MedicationPlan? @relation(fields: [medicationPlanId], references: [id], onDelete: SetNull)

  @@index([status, nextActionAt])
  @@index([patientId, scheduledAt])
  @@map("reminders")
}

// ============================ 打卡与症状 ============================

model CheckIn {
  id         String   @id @default(cuid())
  patientId  String
  type       String // BP | GLUCOSE | TEMP | WEIGHT | SPO2
  value      Json
  note       String?
  measuredAt DateTime
  abnormal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, measuredAt])
  @@map("check_ins")
}

model SymptomReport {
  id                String    @id @default(cuid())
  patientId         String
  content           String
  level             RiskLevel
  advice            String?
  redFlags          String[]  @default([])
  aiRaw             Json?
  clinicianReviewed Boolean   @default(false)
  createdAt         DateTime  @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  alerts  Alert[]

  @@index([patientId, createdAt])
  @@map("symptom_reports")
}

model Alert {
  id              String        @id @default(cuid())
  patientId       String
  severity        AlertSeverity
  source          AlertSource
  symptomReportId String?
  message         String
  status          AlertStatus   @default(OPEN)
  handledById     String?
  handledAt       DateTime?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptomReport SymptomReport? @relation(fields: [symptomReportId], references: [id], onDelete: SetNull)
  handledBy     User?          @relation("AlertHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([patientId])
  @@map("alerts")
}

// ============================ 智能问答 ============================

model Conversation {
  id        String   @id @default(cuid())
  patientId String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([patientId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  role           ConversationRole
  content        String
  meta           Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================ 知识库（RAG）============================

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  category  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@map("knowledge_docs")
}

model KnowledgeChunk {
  id        String                       @id @default(cuid())
  docId     String
  content   String
  embedding Unsupported("vector(1536)")?
  tokens    Int?
  createdAt DateTime                     @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("knowledge_chunks")
}

// ============================ 通知与审计 ============================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String    @default("SYSTEM")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
